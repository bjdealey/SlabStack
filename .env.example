# SlabStack configuration. Copy to .env and edit as needed — every value has a
# working default, so an empty .env is fine.

# Where the SQLite database and uploaded images live. Back this directory up:
# it is your entire collection, price history and analysis.
# SLABSTACK_DATA_DIR=./backend/data

# Override the SQLAlchemy URL (defaults to sqlite at DATA_DIR/slabstack.db).
# SLABSTACK_DATABASE_URL=sqlite+pysqlite:////absolute/path/slabstack.db

# SLABSTACK_HOST=127.0.0.1
# SLABSTACK_PORT=8000

# Upload limit in bytes (default 25 MB).
# SLABSTACK_MAX_IMAGE_BYTES=26214400

# --- Market data providers (Phase 3) -----------------------------------------
# Keys are read from the environment at call time. The database stores only the
# NAME of the variable, never a key. Every provider ships disabled; enabling one
# is a change in Settings, not here.
# SLABSTACK_POKEPRICE_API_KEY=
# SLABSTACK_PRICECHARTING_API_KEY=
# SLABSTACK_EBAY_APP_ID=
# SLABSTACK_CARDMARKET_TOKEN=
# SLABSTACK_TCGPLAYER_TOKEN=
# SLABSTACK_POKEMONTCG_API_KEY=
